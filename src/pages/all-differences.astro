---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import {
  getGameConfig,
  getDifferences,
  generateBreadcrumbSchema,
} from '@/lib/data';

const config = getGameConfig();
const differences = getDifferences();

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Known Differences', url: '/all-differences/' },
]);

const rooms = [...new Set(differences.map(d => d.room))].sort();
const changeTypeLabel: Record<string, string> = { moved: '↔️ Moved', missing: '❌ Missing', opened: '📂 Opened', damaged: '💥 Damaged', 'new': '✨ New' };
const verifiedLabel: Record<string, { text: string; color: string }> = {
  'demo': { text: '✓ Verified in demo', color: 'text-green-400' },
  'unconfirmed': { text: '? Unconfirmed', color: 'text-yellow-400' },
  'may-vary': { text: '🎲 May vary', color: 'text-orange-400' },
};
---

<BaseLayout
  title="Dread Disc All Differences"
  description="Known Dread Disc differences organized by room and change type. Verified demo data with status badges. Additional differences may exist."
>
  <JsonLd schema={breadcrumbSchema} />

  <section class="max-w-5xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-red-400 transition-colors">Home</a>
      <span class="mx-2">›</span>
      <span class="text-gray-300">Known Differences</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold mb-4 text-gray-100">
      Known Dread Disc Differences
    </h1>

    <p class="text-gray-400 mb-4 leading-relaxed">
      Summary of known differences in Dread Disc. For an interactive version with filtering and checkboxes, see the <a href="/differences-checklist/" class="text-red-400 hover:text-red-300">Differences Checklist</a>.
    </p>
    <p class="text-gray-500 text-sm mb-4 italic">
      These are known differences verified in the demo. Additional differences may exist.
    </p>

    <div class="flex flex-wrap gap-3 mb-6">
      <span class="text-xs bg-gray-800 text-gray-400 px-3 py-1.5 rounded-full border border-gray-700/50">{differences.length} known differences</span>
      <span class="text-xs bg-green-900/30 text-green-400 px-3 py-1.5 rounded-full border border-green-700/40">✓ {differences.filter(d => d.verified === 'demo').length} verified in demo</span>
    </div>

    <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4 mb-8">
      <h2 class="text-sm font-bold text-gray-300 mb-2">Verification Legend</h2>
      <div class="flex flex-wrap gap-3 text-xs">
        <span class="text-green-400">✓ Verified in demo</span>
        <span class="text-yellow-400">? Unconfirmed</span>
        <span class="text-orange-400">🎲 May vary by randomized run</span>
      </div>
    </div>

    <!-- Summary Table -->
    <div class="mb-12">
      <h2 class="text-xl font-bold mb-4 text-gray-200">Difference Summary</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700/50">
              <th class="text-left py-3 px-3 text-gray-400 font-medium">Room</th>
              <th class="text-left py-3 px-3 text-gray-400 font-medium">Object</th>
              <th class="text-left py-3 px-3 text-gray-400 font-medium">Change</th>
              <th class="text-left py-3 px-3 text-gray-400 font-medium hidden sm:table-cell">Description</th>
              <th class="text-left py-3 px-3 text-gray-400 font-medium">Status</th>
            </tr>
          </thead>
          <tbody>
            {differences.map((diff, i) => {
              const vl = verifiedLabel[diff.verified];
              return (
                <tr class={`border-b border-gray-800/50 ${i % 2 === 0 ? 'bg-gray-800/20' : ''}`}>
                  <td class="py-3 px-3 text-gray-300">{diff.room}</td>
                  <td class="py-3 px-3 text-gray-200 font-medium">{diff.objectName}</td>
                  <td class="py-3 px-3"><span class="text-xs">{changeTypeLabel[diff.changeType]}</span></td>
                  <td class="py-3 px-3 text-gray-500 hidden sm:table-cell">{diff.description}</td>
                  <td class="py-3 px-3"><span class={`text-xs ${vl.color}`}>{vl.text}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- By Room Breakdown -->
    <div class="mb-12">
      <h2 class="text-xl font-bold mb-4 text-gray-200">By Room</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {rooms.map(room => {
          const roomDiffs = differences.filter(d => d.room === room);
          return (
            <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold text-gray-200">📍 {room}</h3>
                <span class="text-xs text-gray-500">{roomDiffs.length} differences</span>
              </div>
              <ul class="space-y-1.5">
                {roomDiffs.map(diff => (
                  <li class="text-sm text-gray-400 flex items-center gap-2">
                    <span class="text-xs">{changeTypeLabel[diff.changeType]}</span>
                    <span class="text-gray-300">{diff.objectName}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>

    <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4 mb-8">
      <p class="text-xs text-gray-400">
        ⚠️ Data covers demo content only. Additional differences will be documented after full release. Last updated: {config.game.lastUpdated}. Dread Disc randomized elements mean each run produces different differences — this list represents known changes, not a guaranteed set.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      <a href="/differences-checklist/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors text-center">
        <span class="text-2xl block mb-2">🔍</span>
        <span class="font-semibold text-sm text-gray-200">Interactive Checklist</span>
      </a>
      <a href="/apartment-changes/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors text-center">
        <span class="text-2xl block mb-2">🏠</span>
        <span class="font-semibold text-sm text-gray-200">Apartment Changes</span>
      </a>
      <a href="/survival-guide/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors text-center">
        <span class="text-2xl block mb-2">💀</span>
        <span class="font-semibold text-sm text-gray-200">Survival Guide</span>
      </a>
    </div>
  </section>
</BaseLayout>
