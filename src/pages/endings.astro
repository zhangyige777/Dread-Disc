---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import {
  getGameConfig,
  generateBreadcrumbSchema,
} from '@/lib/data';

const config = getGameConfig();

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Endings', url: '/endings/' },
]);
---

<BaseLayout
  title="Dread Disc Endings Guide"
  description="Dread Disc endings guide. Demo outcomes documented, full game endings will be added after release. Status: Coming Soon."
>
  <JsonLd schema={breadcrumbSchema} />

  <section class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-red-400 transition-colors">Home</a>
      <span class="mx-2">›</span>
      <span class="text-gray-300">Endings</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold mb-4 text-gray-100">
      Dread Disc Endings
    </h1>

    <!-- Status Notice -->
    <div class="bg-amber-900/20 border border-amber-700/40 rounded-xl p-4 mb-6">
      <p class="text-sm text-amber-300">
        ⚠️ The full game has not been released yet. This page documents what is known from the demo. Full endings data will be added after release.
      </p>
    </div>

    <p class="text-gray-400 mb-8 leading-relaxed">
      Dread Disc appears to have multiple possible endings based on player performance during observation cycles.
      Below is what we currently know about the demo endings.
    </p>

    <div class="bg-red-900/20 border border-red-700/40 rounded-xl p-4 mb-6">
      <p class="text-sm text-red-300">
        <strong>Important:</strong> Full ending information will be updated after the official release. The content below reflects demo observations only and is not a complete endings guide. Verified in demo / May change before full release.
      </p>
    </div>

    <p class="text-sm text-gray-400 mb-4">Looking for a Dread Disc ending explained breakdown? We document what is currently known from demo playthroughs below.</p>

    <!-- Demo Endings -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-gray-200">Demo Endings</h2>
      <div class="space-y-4">
        <div class="bg-gray-800/50 border border-green-700/30 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs bg-green-900/30 text-green-400 px-2 py-0.5 rounded">✓ Verified in demo</span>
          </div>
          <h3 class="font-bold text-gray-200 mb-1">Successful Survival Ending</h3>
          <p class="text-sm text-gray-400">
            Completing enough observation cycles while maintaining door/window security and identifying a sufficient number of differences leads to a successful outcome.
            The demo ending sets up the narrative for the full game.
          </p>
        </div>
        <div class="bg-gray-800/50 border border-red-700/30 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs bg-red-900/30 text-red-400 px-2 py-0.5 rounded">✓ Verified in demo</span>
          </div>
          <h3 class="font-bold text-gray-200 mb-1">Failure Ending</h3>
          <p class="text-sm text-gray-400">
            Failing to secure critical entry points or missing too many differences can trigger a failure state.
            The specific failure conditions depend on which entry points were left unsecured.
          </p>
        </div>
        <div class="bg-gray-800/50 border border-yellow-700/30 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs bg-yellow-900/30 text-yellow-400 px-2 py-0.5 rounded">? Unconfirmed</span>
          </div>
          <h3 class="font-bold text-gray-200 mb-1">Alternative Outcomes</h3>
          <p class="text-sm text-gray-400">
            Players have reported different outcomes depending on observation choices and which differences were identified.
            Whether these represent distinct endings or variations is unconfirmed.
          </p>
        </div>
      </div>
    </div>

    <!-- Full Game -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-200">Full Game Endings</h2>
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <p class="text-sm text-gray-400">
          The full game's ending structure has not been announced. Given the randomized elements and multiple possible outcomes in the demo,
          the full release will likely expand on this with more endings, hidden conditions, and narrative consequences.
        </p>
        <p class="text-sm text-gray-500 mt-3">
          This page will be updated with complete endings data after the full game releases.
          Follow the <a href="/release-date/" class="text-red-400 hover:text-red-300">release date page</a> for updates.
        </p>
      </div>
    </div>

    <p class="text-center text-xs text-gray-600 mb-8">
      Last updated: {config.game.lastUpdated} · Status: Demo information verified · Full release may change
    </p>

    <div class="grid sm:grid-cols-3 gap-4">
      <a href="/demo-walkthrough/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors text-center">
        <span class="text-2xl block mb-2">🎮</span>
        <span class="font-semibold text-sm text-gray-200">Demo Walkthrough</span>
      </a>
      <a href="/survival-guide/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors text-center">
        <span class="text-2xl block mb-2">💀</span>
        <span class="font-semibold text-sm text-gray-200">Survival Guide</span>
      </a>
      <a href="/release-date/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors text-center">
        <span class="text-2xl block mb-2">📅</span>
        <span class="font-semibold text-sm text-gray-200">Release Date</span>
      </a>
    </div>
  </section>
</BaseLayout>
