---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import DoorWindowChecklist from '@/components/DoorWindowChecklist.tsx';
import {
  getGameConfig,
  getDoorsWindows,
  generateBreadcrumbSchema,
  generateSoftwareApplicationSchema,
} from '@/lib/data';

const config = getGameConfig();
const doorsWindows = getDoorsWindows();

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Doors & Windows', url: '/doors-and-windows/' },
]);

const softwareSchema = generateSoftwareApplicationSchema(
  'Dread Disc Door & Window Safety Checklist',
  'Interactive checklist for securing all doors and windows in Dread Disc with risk level tracking',
  '/doors-and-windows/'
);

const totalCount = doorsWindows.length;
const criticalCount = doorsWindows.filter(dw => dw.riskLevel === 'critical').length;
const highCount = doorsWindows.filter(dw => dw.riskLevel === 'high').length;
---

<BaseLayout
  title="Dread Disc Doors and Windows Guide"
  description="Dread Disc door and window safety checklist. Track entry points, risk levels, and safe actions before it gets in."
>
  <JsonLd schema={[breadcrumbSchema, softwareSchema]} />

  <section class="max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-red-400 transition-colors">Home</a>
      <span class="mx-2">›</span>
      <span class="text-gray-300">Doors & Windows</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold mb-4 text-gray-100">
      Dread Disc Door & Window Safety Checklist
    </h1>

    <p class="text-gray-400 mb-4 leading-relaxed">
      The core mechanic of Dread Disc: <strong class="text-red-400">lock every door and window before it gets in</strong>.
      Use this checklist to track the status of every entry point in the apartment.
    </p>

    <!-- Quick Stats -->
    <div class="flex flex-wrap gap-3 mb-6">
      <span class="text-xs bg-gray-800 text-gray-400 px-3 py-1.5 rounded-full border border-gray-700/50">
        {totalCount} doors & windows
      </span>
      {criticalCount > 0 && (
        <span class="text-xs bg-red-900/30 text-red-400 px-3 py-1.5 rounded-full border border-red-700/40">
          🚨 {criticalCount} critical
        </span>
      )}
      {highCount > 0 && (
        <span class="text-xs bg-red-900/20 text-red-300 px-3 py-1.5 rounded-full border border-red-700/30">
          🔴 {highCount} high risk
        </span>
      )}
    </div>

    <!-- Core Rule -->
    <div class="bg-red-900/20 border border-red-700/40 rounded-xl p-5 mb-6">
      <h2 class="text-sm font-bold text-red-400 mb-2">🔒 Core Survival Rule</h2>
      <p class="text-sm text-red-200/80">
        Before leaving the apartment, <strong>every door and window must be closed and locked</strong>.
        Any unsecured entry point increases the risk of failure in the next cycle.
        Prioritize critical and high-risk entry points first.
      </p>
    </div>

    <!-- Disclaimer -->
    <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4 mb-8">
      <p class="text-xs text-gray-400">
        ⚠️ Data covers demo content only. Door and window behavior may change in the full release. Last updated: {config.game.lastUpdated}.
      </p>
    </div>

    <!-- Interactive Checklist -->
    <div class="mb-12">
      <DoorWindowChecklist client:load doorsWindows={doorsWindows} />
    </div>

    <!-- Safety Tips -->
    <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-6 mb-12">
      <h2 class="text-xl font-bold mb-4 text-gray-200">Safety Tips</h2>
      <div class="mb-4 space-y-2">
        <div class="flex items-center gap-2 text-xs">
          <span class="w-3 h-3 rounded-full bg-red-500"></span>
          <span class="text-red-400 font-medium">Critical/High Risk</span>
          <span class="text-gray-500">— Front door, balcony door. Must be secured every cycle.</span>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
          <span class="text-yellow-400 font-medium">Medium Risk</span>
          <span class="text-gray-500">— Kitchen window, bedroom window. Check each cycle.</span>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="w-3 h-3 rounded-full bg-green-500"></span>
          <span class="text-green-400 font-medium">Low Risk</span>
          <span class="text-gray-500">— Bathroom door, kitchen door. Verify state but lower priority.</span>
        </div>
      </div>
      <ul class="space-y-2 text-sm text-gray-400">
        <li class="flex gap-2"><span class="text-red-400">1.</span> Always check the front door first — it's the highest-risk entry point.</li>
        <li class="flex gap-2"><span class="text-red-400">2.</span> Verify the balcony/back door lock is engaged after every cycle.</li>
        <li class="flex gap-2"><span class="text-red-400">3.</span> Windows can change state between checks — don't assume they stayed closed.</li>
        <li class="flex gap-2"><span class="text-red-400">4.</span> Check for visual changes through glass — cracks or movement outside are warning signs.</li>
        <li class="flex gap-2"><span class="text-red-400">5.</span> In later cycles, previously locked doors may become unlocked without warning.</li>
      </ul>
    </div>

    <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4 mb-8">
      <p class="text-xs text-gray-400">
        Last updated: {config.game.lastUpdated} · Status: Demo data verified · Differences may vary by randomized run
      </p>
    </div>

    <!-- Related Guides -->
    <div class="mb-8">
      <h2 class="text-xl font-bold mb-4 text-gray-200">Related Guides</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/differences-checklist/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors">
          <span class="text-2xl block mb-2">🔍</span>
          <span class="font-semibold text-sm text-gray-200">Differences Checklist</span>
          <p class="text-xs text-gray-500 mt-1">Track all apartment changes</p>
        </a>
        <a href="/survival-guide/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors">
          <span class="text-2xl block mb-2">💀</span>
          <span class="font-semibold text-sm text-gray-200">Survival Guide</span>
          <p class="text-xs text-gray-500 mt-1">Full rules & failure causes</p>
        </a>
        <a href="/demo-walkthrough/" class="p-4 rounded-xl border border-gray-700/50 bg-gray-800/50 hover:border-red-700/40 transition-colors">
          <span class="text-2xl block mb-2">🎮</span>
          <span class="font-semibold text-sm text-gray-200">Demo Walkthrough</span>
          <p class="text-xs text-gray-500 mt-1">Step-by-step guide</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
