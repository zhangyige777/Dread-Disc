---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { generateBreadcrumbSchema } from '@/lib/data';
import JsonLd from '@/components/JsonLd.astro';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
]);
---

<BaseLayout title="Contact - Dread Disc Guide" description="Contact information for the Dread Disc Guide fan site. Report errors, suggest improvements, or get in touch.">
  <JsonLd schema={breadcrumbSchema} />

  <section class="max-w-3xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-red-400 transition-colors">Home</a>
      <span class="mx-2">›</span>
      <span class="text-gray-300">Contact</span>
    </nav>

    <h1 class="text-3xl font-extrabold mb-6 text-gray-100">Contact Us</h1>

    <div class="space-y-6 text-gray-400 text-sm leading-relaxed">

      <!-- Fan Disclaimer -->
      <div class="bg-red-900/20 border border-red-800/40 rounded-xl p-5">
        <h2 class="font-bold text-red-400 mb-2 text-base">Fan-Made Site — Not the Developer</h2>
        <p>
          <strong class="text-gray-200">Dread Disc Guide</strong> is a fan-made, unofficial companion site.
          We are <strong class="text-gray-200">not</strong> the developers of Dread Disc and cannot provide game support.
          If you need to reach the developer (MadBug) about game bugs or technical issues, please use the channels listed below.
        </p>
      </div>

      <!-- What Feedback We Accept -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">What Kind of Feedback We Accept</h2>
        <p class="mb-3">
          We welcome all feedback that helps us improve the guide. Specifically, we are looking for:
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>
              <strong class="text-gray-200">Errors &amp; Inaccuracies</strong> — If you find incorrect game data, wrong item descriptions,
              outdated walkthrough steps, or any factual error on the site, please let us know. Include the page URL and what specifically is wrong.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>
              <strong class="text-gray-200">Outdated Information</strong> — Game content changes with updates. If you notice that our data does
              not reflect the current demo version (e.g., new rooms, changed mechanics, removed features), report it so we can update accordingly.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>
              <strong class="text-gray-200">Suggestions &amp; Feature Requests</strong> — Ideas for new tools, checklist categories, guide sections,
              or quality-of-life improvements. We prioritize suggestions that benefit the most players.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>
              <strong class="text-gray-200">Broken Features</strong> — If a checklist is not saving, a filter is not working, a page is not loading,
              or any interactive element is malfunctioning, report it with your browser and device information so we can fix it.
            </span>
          </li>
        </ul>
      </div>

      <!-- Game Support Redirect -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Game Support — Contact MadBug</h2>
        <p class="mb-3">
          We cannot help with in-game bugs, crashes, performance issues, or account problems. For game-related support, contact the developer directly:
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>
              <strong class="text-gray-200">itch.io:</strong>
              <a href="https://madbug.itch.io/dread-disc" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">madbug.itch.io/dread-disc</a>
              — Use the community section or send a direct message to the developer
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>
              <strong class="text-gray-200">Steam Community:</strong>
              <a href="https://store.steampowered.com/app/4156540/Dread_Disc/" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">Steam Discussions</a>
              — Post in the game's community hub for bugs, feedback, and troubleshooting
            </span>
          </li>
        </ul>
        <p class="mt-3 text-gray-500">
          MadBug is the sole developer of Dread Disc and the best resource for game-related questions.
        </p>
      </div>

      <!-- Data Correction Process -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Data Correction Process</h2>
        <p class="mb-3">
          When you report incorrect data, here is what happens:
        </p>
        <ol class="space-y-3 list-decimal list-inside">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0 font-bold">1.</span>
            <span><strong class="text-gray-200">Review</strong> — We review the reported issue against the official Steam page, itch.io devlog, and current demo version to verify the discrepancy.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0 font-bold">2.</span>
            <span><strong class="text-gray-200">Verify</strong> — If the correction is confirmed, we update the relevant page and adjust the verification status tag accordingly.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0 font-bold">3.</span>
            <span><strong class="text-gray-200">Publish</strong> — Corrections are typically published within 48 hours of verification. The page's "last updated" date is refreshed.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0 font-bold">4.</span>
            <span><strong class="text-gray-200">If disputed</strong> — If a reported issue cannot be verified, we mark the relevant content as "Unconfirmed" until further evidence is available.</span>
          </li>
        </ol>
        <p class="mt-3 text-gray-500">
          We appreciate every correction — even small ones. Accurate data makes the guide better for everyone.
        </p>
      </div>

      <!-- How to Reach Us -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">How to Reach Us</h2>
        <p class="mb-3">
          You can submit feedback or corrections through the following methods:
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>Leave a comment or message on the community channels where this guide is shared</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>Reach out through any social media or forum accounts associated with this project</span>
          </li>
        </ul>
        <p class="mt-3 text-gray-500">
          When reporting an issue, please include: the page URL, a description of what is wrong, and (if possible) a screenshot or reference to the correct information.
        </p>
      </div>

      <!-- Response Expectations -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Response Time</h2>
        <p>
          This site is maintained by fans in their spare time. We aim to review all feedback within 72 hours and publish verified corrections
          within 48 hours after confirmation. Feature requests and suggestions are evaluated on a rolling basis and prioritized by demand.
          We may not respond to every message, but we read and appreciate all feedback.
        </p>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="text-sm text-red-400 hover:text-red-300 transition-colors">&#8592; Back to Home</a>
    </div>
  </section>
</BaseLayout>
