---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { generateBreadcrumbSchema } from '@/lib/data';
import JsonLd from '@/components/JsonLd.astro';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy-policy/' },
]);
---

<BaseLayout title="Privacy Policy - Dread Disc Guide" description="Privacy policy for the Dread Disc Guide fan site.">
  <JsonLd schema={breadcrumbSchema} />

  <section class="max-w-3xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-red-400 transition-colors">Home</a>
      <span class="mx-2">›</span>
      <span class="text-gray-300">Privacy Policy</span>
    </nav>

    <h1 class="text-3xl font-extrabold mb-6 text-gray-100">Privacy Policy</h1>

    <div class="space-y-6 text-gray-400 text-sm leading-relaxed">
      <p><strong class="text-gray-200">Last updated:</strong> May 2026</p>

      <p>
        This privacy policy describes how the Dread Disc Guide ("we", "us", "this site") handles your data when you visit our website.
        We are committed to being transparent about what information we collect and how we use it. Since this is a fan-made guide site,
        our data practices are minimal by design.
      </p>

      <!-- Information We Collect -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Information We Collect</h2>
        <p class="mb-3">
          We do <strong class="text-gray-200">not</strong> collect any personally identifiable information. We do not require user accounts,
          sign-ups, email addresses, or any form of registration. You can use every feature of this site anonymously.
        </p>
        <p>
          The only data we collect is <strong class="text-gray-200">anonymous, aggregated analytics</strong> through third-party services
          (described below). This data cannot be used to identify you personally.
        </p>
      </div>

      <!-- Google Analytics 4 -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Google Analytics 4</h2>
        <p class="mb-3">
          This site uses <strong class="text-gray-200">Google Analytics 4 (GA4)</strong> to understand how visitors interact with our content.
          GA4 helps us learn which pages are most useful and where we can improve the site. The data collected by GA4 is anonymous and includes:
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Page views</strong> — Which pages you visit and how you navigate between them</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Time on site</strong> — How long you spend on each page and the site overall</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">General location</strong> — Country and city-level data based on IP address (not your exact location)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Device and browser type</strong> — Operating system, browser, and screen resolution for optimizing site layout</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Referral source</strong> — How you found the site (search engine, direct link, social media)</span>
          </li>
        </ul>
        <p class="mt-3 text-gray-500">
          GA4 data is processed by Google under their privacy policy. We do not have access to information that identifies individual users.
          For more details, see the <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">Google Privacy Policy</a>.
        </p>
      </div>

      <!-- Advertising Partners -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Advertising Partners</h2>
        <p class="mb-3">
          This site may display advertisements served by third-party ad networks, including but not limited to Google AdSense.
          These advertising partners may use cookies, web beacons, and similar technologies to serve ads based on your browsing activity.
        </p>
        <p class="mb-3">What this means for you:</p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>Ad networks may set their own cookies on your browser to track ad performance and relevance</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>These cookies are managed by the respective ad networks, not by us</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>You can opt out of personalized advertising through network-specific tools (e.g., <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">Google Ad Settings</a>) or the <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">Network Advertising Initiative opt-out page</a></span>
          </li>
        </ul>
        <p class="mt-3 text-gray-500">
          We do not have control over the cookies set by third-party advertising networks. Their use of data is governed by their own privacy policies.
        </p>
      </div>

      <!-- Cookies -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Cookies</h2>
        <p class="mb-3">
          This site uses cookies in two categories:
        </p>
        <div class="space-y-4">
          <div>
            <h3 class="text-gray-300 font-semibold mb-1">First-Party Cookies</h3>
            <p>
              Set directly by our site. These include any preferences you set (such as dark/light mode toggles if available)
              and technical cookies needed for the site to function properly. First-party cookies do not track you across other websites.
            </p>
          </div>
          <div>
            <h3 class="text-gray-300 font-semibold mb-1">Third-Party Cookies</h3>
            <p>
              Set by external services such as Google Analytics and advertising networks. These cookies may track your browsing behavior
              across multiple websites for analytics and ad targeting purposes. We do not control these cookies directly.
            </p>
          </div>
        </div>
        <p class="mt-3">
          You can manage, block, or delete cookies through your browser settings. Most browsers allow you to view active cookies,
          set preferences for specific sites, and clear all cookies. See your browser's help documentation for instructions.
        </p>
      </div>

      <!-- Local Storage -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Local Storage</h2>
        <p class="mb-3">
          The interactive checklists on this site (differences checklist, door &amp; window safety checklist) use your browser's
          <strong class="text-gray-200">localStorage</strong> to save your progress automatically. Here is what you should know:
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>Checklist progress is stored <strong class="text-gray-200">only on your device</strong> — it is never transmitted to our servers or any third party</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>Clearing your browser data or using a different device will reset your checklist progress</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>We do not have access to your saved progress and cannot recover it if lost</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>localStorage data does not expire automatically — it persists until you clear it</span>
          </li>
        </ul>
      </div>

      <!-- Third-Party Links -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Third-Party Links</h2>
        <p class="mb-3">
          This site contains links to external websites, including:
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><a href="https://store.steampowered.com/" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">Steam</a> (game store and community hub)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><a href="https://madbug.itch.io/dread-disc" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">itch.io</a> (developer page and demo downloads)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>Reddit and other community discussion platforms</span>
          </li>
        </ul>
        <p class="mt-3">
          These third-party sites have their own privacy policies and data practices, which are beyond our control.
          We encourage you to review the privacy policies of any external site before sharing personal information with them.
          This privacy policy applies only to the Dread Disc Guide website.
        </p>
      </div>

      <!-- Data Retention & Your Rights -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Data Retention &amp; Your Rights</h2>
        <p class="mb-3">
          Since we collect minimal data, there is very little to retain or manage. Here is a summary of your rights:
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Analytics data</strong> is retained by Google Analytics for up to 14 months (our configured retention period) and then automatically deleted</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Checklist data</strong> stays in your browser until you manually clear it or your browser clears stored data</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span><strong class="text-gray-200">Cookies</strong> can be managed, blocked, or deleted at any time through your browser settings</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5 shrink-0">&#9656;</span>
            <span>You may opt out of Google Analytics tracking entirely by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300">Google Analytics Opt-out Browser Add-on</a></span>
          </li>
        </ul>
        <p class="mt-3 text-gray-500">
          Because we do not collect personal data, we do not have a process for data access or deletion requests. If you believe there is an issue, please reach out via our contact page.
        </p>
      </div>

      <!-- Policy Changes -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Changes to This Policy</h2>
        <p>
          We may update this privacy policy from time to time to reflect changes in our practices or applicable regulations.
          Any changes will be posted on this page with an updated "Last updated" date. We encourage you to review this page periodically.
        </p>
      </div>

      <!-- Contact -->
      <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5">
        <h2 class="font-bold text-gray-200 mb-3 text-base">Questions About This Policy</h2>
        <p>
          If you have questions or concerns about this privacy policy or how your data is handled on this site, please visit our
          <a href="/contact/" class="text-red-400 hover:text-red-300">contact page</a> to get in touch. We will do our best to respond promptly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
